# MedCare backend runtime configuration.
# Copy to `.env` and adjust per environment. Never commit real credentials.

# Node environment: development | test | production
NODE_ENV=development

# HTTP server
PORT=3000

# PostgreSQL connection string (medcare database)
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/medcare

# Connection pool tuning
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_CONNECTION_TIMEOUT_MS=5000

# Comma-separated list of allowed browser origins for /api/**
CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# In-memory TTL for /api/master/* responses
MASTER_CACHE_TTL_MS=3600000

# FastAPI sidecar URL (ML pipeline service)
ML_SIDECAR_URL=http://localhost:8000
